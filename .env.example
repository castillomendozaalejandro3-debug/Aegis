# =============================================================================
# Project Aegis-Peru - Environment Configuration
# =============================================================================
# IMPORTANTE: Copiar este archivo a .env y modificar TODOS los valores
# antes de desplegar en produccion. NUNCA subir .env al repositorio.
# =============================================================================

# ── ENTORNO ─────────────────────────────────────────────────────────────────
# Valores permitidos: development, staging, production
AEGIS_ENV=production

# ── BASE DE DATOS POSTGRESQL ────────────────────────────────────────────────
# Generar password seguro: openssl rand -base64 32
POSTGRES_DSN=postgresql+asyncpg://aegis:CAMBIAR_ESTO@postgres:5432/aegis_peru
POSTGRES_PASSWORD=CAMBIAR_ESTO_MINIMO_32_CARACTERES_ALEATORIOS
POSTGRES_POOL_SIZE=20

# ── NEO4J ───────────────────────────────────────────────────────────────────
# Generar password seguro: openssl rand -base64 32
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CAMBIAR_ESTO_MINIMO_32_CARACTERES_ALEATORIOS
NEO4J_MAX_POOL_SIZE=50

# ── REDIS ───────────────────────────────────────────────────────────────────
# Generar password seguro: openssl rand -base64 32
REDIS_URL=redis://:CAMBIAR_ESTO@redis:6379/0
REDIS_PASSWORD=CAMBIAR_ESTO_MINIMO_32_CARACTERES_ALEATORIOS

# ── JWT (CRITICO) ─────────────────────────────────────────────────────────
# Generar secreto seguro: openssl rand -base64 32
# Este secreto firma todos los tokens JWT. SI SE COMPROMETE, ROTAR INMEDIATAMENTE.
JWT_SECRET=CAMBIAR_ESTO_GENERAR_NUEVO_SECRETO_DE_32_CARACTERES_MINIMO
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# ── MFA ─────────────────────────────────────────────────────────────────────
MFA_ENABLED=true

# ── QDRANT ──────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aegis_entities

# ── TOR / ANONIMATO ───────────────────────────────────────────────────────
TOR_PROXY=socks5h://tor-gateway:9050
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=
TOR_VERIFY_IP=true
TOR_MAX_RETRIES=3

# ── VAULT ───────────────────────────────────────────────────────────────────
VAULT_ADDR=http://vault-agent:8200
VAULT_TOKEN=
VAULT_MOUNT_POINT=secret
VAULT_PATH=aegis-peru

# ── API KEYS EXTERNAS (OPCIONALES) ────────────────────────────────────────
# OpenAI - Para NER, VLM, generacion de reportes
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Shodan - Para reconocimiento de infraestructura
SHODAN_API_KEY=

# Censys - Para reconocimiento de infraestructura
CENSYS_API_ID=
CENSYS_API_SECRET=

# ── mTLS ────────────────────────────────────────────────────────────────────
MTLS_ENABLED=true
MTLS_CERT_PATH=/certs/client.crt
MTLS_KEY_PATH=/certs/client.key
MTLS_CA_PATH=/certs/ca.crt

# ── LOGGING ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
JSON_LOGS=true
LOG_REQUEST_ID=true

# ── RATE LIMITING ───────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── AEGIS CORE ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/tiff
EVIDENCE_STORAGE_PATH=/app/evidence
UPLOAD_STORAGE_PATH=/app/uploads

# ── LANGGRAPH ───────────────────────────────────────────────────────────────
GRAPH_CHECKPOINT_INTERVAL=5
GRAPH_MAX_ITERATIONS=20
GRAPH_TIMEOUT_SECONDS=300

# ── SCRAPERS ────────────────────────────────────────────────────────────────
SCRAPER_TIMEOUT=30
SCRAPER_MAX_RETRIES=3
SCRAPER_DELAY_MIN=2.0
SCRAPER_DELAY_MAX=5.0
SCRAPER_HEADLESS=true

# ── GRAFANA ────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=CAMBIAR_ESTO_MINIMO_16_CARACTERES
